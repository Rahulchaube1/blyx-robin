use std::cli;
use robin;

fn matches(actual: vector, expected: vector) -> bool {
    if len(actual) != len(expected) { return false; }
    let mut i = 0;
    while i < len(expected) {
        let delta = at(actual, i) - at(expected, i);
        let limit = 0.000000001 + 0.000000001 * at(expected, i) * at(expected, i) / (1.0 + at(expected, i) * at(expected, i));
        if !(delta >= -limit && delta <= limit) { return false; }
        i += 1;
    }
    true
}

fn main() {
    let infinity = 1.0e300 * 1.0e300;
    if !matches(robin_date(1970.0, 1.0, 1.0), [719163, 3, 1, 31]) { stderr_line("case 1 failed"); process_exit(1); }
    if !matches(robin_date(1.0, 1.0, 1.0), [1, 0, 1, 31]) { stderr_line("case 2 failed"); process_exit(1); }
    if !matches(robin_date(1900.0, 2.0, 29.0), []) { stderr_line("case 3 failed"); process_exit(1); }
    if !matches(robin_date(2000.0, 2.0, 29.0), [730179, 1, 60, 29]) { stderr_line("case 4 failed"); process_exit(1); }
    if !matches(robin_date(infinity, 1.0, 1.0), []) { stderr_line("case 5 failed"); process_exit(1); }
    if !matches(robin_date(1970.0, infinity, 1.0), []) { stderr_line("case 6 failed"); process_exit(1); }
    if !matches(robin_date(1970.0, 1.0, infinity), []) { stderr_line("case 7 failed"); process_exit(1); }
    println!("passed");
}
